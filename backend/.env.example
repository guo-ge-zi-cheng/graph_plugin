# Optional: MCP, CLI, JSON import, and manual editing need no LLM credentials.
# Copy to backend/.env and supply your own provider settings for standalone chat.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# All processes must share the same GRAPH_DATA_DIR to see the same graphs.
# GRAPH_DATA_DIR=/absolute/path/to/private/graphs
